# Скопируйте этот файл в .env и заполните первые четыре строки.

# ---------- Обязательные ----------

# Токен бота для уведомлений: создайте бота у @BotFather
BOT_TOKEN=
# Ваш chat_id: узнать командой  python -m giftbot chatid
ADMIN_CHAT_ID=
# Данные приложения Telegram: my.telegram.org → API development tools
API_ID=
API_HASH=

# ---------- Площадки ----------

MARKETS=portals,tonnel

# ---------- Когда присылать уведомление ----------

# Цена лота, TON
MIN_BUY_PRICE_TON=1
MAX_BUY_PRICE_TON=50
# Минимальная прибыль после всех комиссий: в TON и в процентах. Должны выполняться оба условия
MIN_PROFIT_TON=0.5
MIN_PROFIT_PCT=5
# На сколько процентов дешевле самого дешёвого конкурента вы будете выставлять подарок
UNDERCUT_PCT=1
# Сколько конкурирующих лотов той же модели должно быть, чтобы доверять цене
MIN_REF_LISTINGS=3
# Сколько самых дешёвых лотов запрашивать при проверке (больше MIN_REF_LISTINGS хотя бы на 1)
VERIFY_DEPTH=6
# Лот дешевле этого процента от рынка помечается как подозрительный
ANOMALY_RATIO_PCT=25

# ---------- Комиссии (проверьте актуальные в приложениях площадок!) ----------

# Portals: комиссия уже входит в цену лота, её удерживают с продавца
PORTALS_BUY_FEE_PCT=0
PORTALS_SELL_FEE_PCT=5
# Tonnel: в API цена без комиссии, покупатель доплачивает её сверху
TONNEL_BUY_FEE_PCT=10
TONNEL_SELL_FEE_PCT=0
# Сколько стоит вывести подарок с одной площадки и завести на другую, TON
TRANSFER_COST_TON=0.3

# ---------- Частота запросов и защита ----------

# Пауза между опросами ленты каждой площадки (+ случайная добавка)
POLL_INTERVAL_SEC=8
POLL_JITTER_SEC=4
# Tonnel опрашиваем реже: за частые запросы он блокирует IP сервера (от минут до часов)
TONNEL_POLL_INTERVAL_SEC=30
# Минимальная пауза между любыми двумя запросами к одной площадке
MIN_REQUEST_INTERVAL_SEC=1.5
# Как часто обновлять флоры и данные входа
FLOORS_REFRESH_SEC=180
AUTH_REFRESH_SEC=1800
# Сколько ошибок подряд выключают площадку (изменение формата ответа — сразу)
MAX_CONSECUTIVE_ERRORS=5
# Как часто проверять выключенную площадку
PROBE_INTERVAL_SEC=300
# true — включать площадку обратно автоматически, false — только командой /resume
AUTO_RESUME=true
# Сколько последних лотов брать за один опрос (Tonnel отдаёт максимум 30)
LATEST_LIMIT=30

# ---------- Автопокупка ----------
# off — выключена; dry — тест: бот пишет «купил бы», денег не тратит; live — реальные покупки.
# Даже в live автопокупка включается только командой /autobuy on и выключается после перезапуска.
AUTOBUY_MODE=off
# Где разрешено покупать. Tonnel добавляйте осознанно: он защищается от автоматических покупок
AUTOBUY_MARKETS=portals
# Покупать под перепродажу на другой площадке (перенос подарка придётся делать вручную)
AUTOBUY_CROSS=false
# Порог прибыли для автопокупки — строже, чем для уведомлений
AUTOBUY_MIN_PROFIT_TON=1
AUTOBUY_MIN_PROFIT_PCT=10
# Максимум за одну покупку с комиссией, TON
AUTOBUY_MAX_PRICE_TON=10
# Сколько всего можно потратить за 24 часа, TON
AUTOBUY_DAILY_LIMIT_TON=30
# Сколько покупок за 24 часа
AUTOBUY_MAX_PER_DAY=5
# Сколько купленных и ещё не проданных подарков может висеть одновременно
AUTOBUY_MAX_OPEN=3
# Сколько TON всегда оставлять на балансе площадки
AUTOBUY_RESERVE_TON=0.5
# Пауза между покупками, секунд
AUTOBUY_COOLDOWN_SEC=60
# Сразу выставлять купленное на продажу (только для покупок внутри одной площадки)
AUTOLIST=true
# Как часто проверять, продались ли выставленные подарки, секунд
POSITIONS_CHECK_SEC=300

# ---------- Необязательные ----------

# Прокси для запросов к площадкам и боту уведомлений, например http://user:pass@1.2.3.4:8080
# (на связь с вашим Telegram-аккаунтом не влияет)
PROXY=
# Свой прокси только для одной площадки (иначе берётся PROXY). Например, если Tonnel
# блокирует IP сервера: TONNEL_PROXY=http://user:pass@1.2.3.4:8080
PORTALS_PROXY=
TONNEL_PROXY=
# Если автоматический вход не работает, вставьте initData вручную (см. README)
PORTALS_AUTH_DATA=
TONNEL_AUTH_DATA=
# Адреса API — менять, только если площадка переехала
PORTALS_API_URL=https://portal-market.com/api/
TONNEL_PAGE_URL=https://gifts2.tonnel.network/api/pageGifts
TONNEL_STATS_URL=https://gifts2.tonnel.network/api/filterStats
TONNEL_BALANCE_URL=https://gifts2.tonnel.network/api/balance/info
TONNEL_TRADE_URL=https://gifts.coffin.meme/api/
# Папка для сессии, базы и логов
DATA_DIR=data
